{
  "_comment": "Each platform declares HOW existence is proven. Strategies: json_path (an official/stable JSON API returns an object whose field at `path` equals the username), json_list (API returns a list; some item's `field` equals the username; an empty list means not found), unverifiable (login wall / bot protection: never requested, always UNKNOWN). A bare HTTP 200 on an HTML page is NEVER sufficient. not_found_status lists HTTP codes that the API documents/behaves as 'no such user'. null_means_missing marks APIs that return JSON null for unknown users.",
  "platforms": [
    {"name": "GitHub", "url": "https://api.github.com/users/{u}", "profile": "https://github.com/{u}", "strategy": "json_path", "path": "login", "regex": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$", "auth_env": "GITHUB_TOKEN", "evidence_fields": ["name", "public_repos", "created_at"]},
    {"name": "GitLab", "url": "https://gitlab.com/api/v4/users?username={u}", "profile": "https://gitlab.com/{u}", "strategy": "json_list", "field": "username", "regex": "^[A-Za-z0-9_.-]{2,255}$", "evidence_fields": ["name", "state"]},
    {"name": "Hacker News", "url": "https://hacker-news.firebaseio.com/v0/user/{u}.json", "profile": "https://news.ycombinator.com/user?id={u}", "strategy": "json_path", "path": "id", "null_means_missing": true, "regex": "^[A-Za-z0-9_-]{2,15}$", "evidence_fields": ["karma", "created"]},
    {"name": "Keybase", "url": "https://keybase.io/_/api/1.0/user/lookup.json?usernames={u}&fields=basics", "profile": "https://keybase.io/{u}", "strategy": "json_path", "path": "them.0.basics.username", "null_path_means_missing": "them.0", "regex": "^[A-Za-z0-9_]{2,16}$", "evidence_fields": []},
    {"name": "DEV Community", "url": "https://dev.to/api/users/by_username?url={u}", "profile": "https://dev.to/{u}", "strategy": "json_path", "path": "username", "regex": "^[A-Za-z0-9_]{2,30}$", "evidence_fields": ["name", "joined_at"]},
    {"name": "Docker Hub", "url": "https://hub.docker.com/v2/users/{u}", "profile": "https://hub.docker.com/u/{u}", "strategy": "json_path", "path": "username", "regex": "^[a-z0-9]{4,30}$", "evidence_fields": ["date_joined", "type"]},
    {"name": "Mastodon (mastodon.social)", "url": "https://mastodon.social/api/v1/accounts/lookup?acct={u}", "profile": "https://mastodon.social/@{u}", "strategy": "json_path", "path": "username", "regex": "^[A-Za-z0-9_]{1,30}$", "evidence_fields": ["created_at", "followers_count"]},
    {"name": "Lichess", "url": "https://lichess.org/api/user/{u}", "profile": "https://lichess.org/@/{u}", "strategy": "json_path", "path": "id", "regex": "^[A-Za-z0-9_-]{2,30}$", "evidence_fields": ["createdAt"]},
    {"name": "Chess.com", "url": "https://api.chess.com/pub/player/{u}", "profile": "https://www.chess.com/member/{u}", "strategy": "json_path", "path": "username", "regex": "^[A-Za-z0-9_-]{3,25}$", "evidence_fields": ["joined", "status"]},
    {"name": "Codeforces", "url": "https://codeforces.com/api/user.info?handles={u}", "profile": "https://codeforces.com/profile/{u}", "strategy": "json_path", "path": "result.0.handle", "not_found_status": [400], "not_found_body": "not found", "regex": "^[A-Za-z0-9_.-]{3,24}$", "evidence_fields": []},
    {"name": "Bitbucket", "url": "https://api.bitbucket.org/2.0/workspaces/{u}", "profile": "https://bitbucket.org/{u}/", "strategy": "json_path", "path": "slug", "regex": "^[A-Za-z0-9_-]{1,62}$", "evidence_fields": ["name"]},
    {"name": "Gravatar", "url": "https://en.gravatar.com/{u}.json", "profile": "https://gravatar.com/{u}", "strategy": "json_path", "path": "entry.0.preferredUsername", "regex": "^[A-Za-z0-9_-]{3,40}$", "evidence_fields": []},
    {"name": "Reddit", "url": "https://www.reddit.com/user/{u}/about.json", "profile": "https://www.reddit.com/user/{u}", "strategy": "json_path", "path": "data.name", "regex": "^[A-Za-z0-9_-]{3,20}$", "evidence_fields": []},
    {"name": "Instagram", "profile": "https://www.instagram.com/{u}/", "strategy": "unverifiable", "reason": "Returns a login wall / generic page to unauthenticated clients; existence cannot be determined without bypassing authentication."},
    {"name": "X (Twitter)", "profile": "https://x.com/{u}", "strategy": "unverifiable", "reason": "Requires JavaScript and authentication; unauthenticated responses are identical for existing and missing accounts."},
    {"name": "TikTok", "profile": "https://www.tiktok.com/@{u}", "strategy": "unverifiable", "reason": "Served behind bot protection; unauthenticated HTML does not reliably distinguish accounts."},
    {"name": "LinkedIn", "profile": "https://www.linkedin.com/in/{u}/", "strategy": "unverifiable", "reason": "Returns an authwall to anonymous clients; automated lookup is also against the site's terms."},
    {"name": "Facebook", "profile": "https://www.facebook.com/{u}", "strategy": "unverifiable", "reason": "Login wall for anonymous clients; profile existence is not exposed."}
  ]
}
